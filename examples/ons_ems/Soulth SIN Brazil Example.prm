 TDSANGLEDEV  = F              /   Termination of simulation if angle deviation is large #ALTERADO
 TDSVCOLAPSE  = F              /   Termination of simulation if voltage collapse detected #ALTERADO                                              
 TDSVOSCILL   = T              /   Termination of simulation if renewable voltage oscillation detected
 TDSFREQDEP   = F              /   Variation of Synchr. Machine parameters with frequency                                              
 TDSRMTCTRL   = T              /   Allow remote control                                                                                
 TDSRMVFAIL   = T              /   Removes generators with initialization error from simulation #ALTERADO
 TDSAUTPRT    = F              /   Enables automatic protection systems                                                                
 TDSRUNOFFLNE = F              /   Simulate offline generators (in stand by mode)                                                      
 TDSWCOIREF   = T              /   Uses speed at the center of inertia as reference for generator damping
