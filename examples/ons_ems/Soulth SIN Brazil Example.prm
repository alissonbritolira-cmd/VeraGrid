 SRGRMVNCRCTG = F              /   Remove non-critical contingency                                                                     
 SRGSHWNUMBR  = T              /   Show number of directions in the Security Region Screen? #ALTERADO                                            
 SRGCHGXYLIM  = T              /   Adjust X/Y axis limits in the Security Region Screen?                                               
 SRGNEGGEN    = T              /   Allow negative gen #ALTERADO
 SRGLRGLABEL  = T              /   Display large label #ALTERADO                                                                                 
 SRGDBGSLV    = F              /   Y->enable/disable slave processes msgs in DOS windows                                               
 SRGVOLTOPT   = F              /   Voltage optimization                                                                                
