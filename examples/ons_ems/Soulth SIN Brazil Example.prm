 CTGDSTSLACK  = F              /   Enable distributed slack #ALTERADO
 CTGCURRATING = T              /   Current thermal limit instead of MVA                                                                
 CTGMIDRANGE  = F              /   Discrete shunt and LTC voltage control at middle of range                                           
 CTGSTBDIAG   = T              /   Stabilizes Jacobian diagonal                                                                        
