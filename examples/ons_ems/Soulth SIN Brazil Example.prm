 ORGTAPMAXSUP = 1.4            /   Maximum value for maximum tap                                                                       
 ORGDEFMIN    = -60.           /   Phase shifter minimum angle (deg)                                                                   
 ORGDEFMAX    = 60.            /   Phase shifter maximum angle (deg)                                                                   
 ORGRCCMIN    = 0.000010       /   Minimum DC line resistance (pu) #ALTERADO (0.00010)
 ORGRCCMAX    = 0.             /   Maximum DC line reactance  (pu)                                                                     
 ORGXCCMAX    = 0.000010       /   Maximum DC ground resistance (pu) #ALTERADO (0.00010)
 ORGALFAMIN   = 0.             /   Minimum firing (alpha) angle (deg)                                                                  
 ORGALFAMAX   = 60.            /   Maximum firing (alpha) angle (deg) #ALTERADO CF MELO (30)                                                                  
 ORGGAMAMIN   = 0.             /   Minimum extinction (gamma) angle (deg)                                                              
 ORGGAMAMAX   = 30.            /   Maximum extinction (gamma) angle (deg)                                                              
 ORGVOLTINF   = 0.9            /   Undervoltage alarm threshold (pu)                                                                   
 ORGVOLTSUP   = 1.1            /   Overvoltage alarm threshold (pu)                                                                    
