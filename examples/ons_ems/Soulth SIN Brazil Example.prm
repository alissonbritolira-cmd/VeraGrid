 ORGNULLTAP   = 1.             /   Default tap                                                                                         
 ORGTAPMININF = 0.7            /   Minimum value for minimum tap                                                                       
 ORGTAPMINSUP = 1.             /   Maximum value for minimum tap                                                                       
