!
!  General options
!
 ORGRMVISL    = F              /   Remove small islands after bus translation #ALTERADO
 ORGCHGNAMES  = F              /   Change bus names during bus number translation #ALTERADO                                                      
 ORGADDUDT    = T              /   Add any results to UDT                                                                              
 ORGUDTCOL    = T              /   Display UDT items as columns
 ORGCAPBCURV  = F              /   Use Mvar capability curve instead of fixed limits                                                   
 ORGPWFMONIT  = F              /   Import monitoring parameters from PWF                                                               
 ORGDFAVRDYR  = F              /   Adds default AVR when reading DYR files                                                             
 ORGNOTRFPHS  = F              /   Ignores transformer phase shift when reading RAW files                                              
 ORGANAZNSEQ  = F              /   Import zero/negative sequences from ANA                                                             
 ORGPWFVSPEC  = F              /   Writes controlled voltage instead of bus voltage on PWF files                                       
 ORGOPGENMRG  = F              /   Open generator MW and Mvar limits if MW dispatch is not null
 ORGADJGENMVA = F              /   Adjust Generator MVA to Pmax and Qmax when reading NTW                                              
 ORGSHTSTON   = F              /   Set shunt block status to true when reading format NTW                                              
 ORGDCINVGMIN = F              /   Use DC Inverter minimum gamma when reading format NTW                                               
 ORGSHTOVRBUS = F              /   Allocate initial shunt exceeding shunt limits at bus                                                
 ORGEQVNOPF   = F              /   Allows run equivalent network reduction without power flow convergency                              
 ORGNTWBNT1   = F              /   Processes Bnt1.dat for NTW files (PSR software import only)                                         
 ORGLMTVSPEC  = F              /   Specified controlled voltage bound by monitored limits                                              
 ORGIGFICBTHL = F              /   Ignore thermal limit for fictitious bus connections
 ORGEQV4N5WND = F              /   Reduce 4 or 5 winding trafo into 3 winding trafo
 ORGCONVLOG   = F              /   RT->Plan: Save conversion log reports
 ORGCONVMINER = F              /   RT->Plan: Aggregate units with min inertia
 ORGCONVALLGU = F              /   RT->Plan: Aggregate off gen units
 ORGCONVEQVST = F              /   RT->Plan: Equivalent step up trafo
 ORGCONVEQSTX = F              /   RT->Plan: Adjust stepup trafo impedance to keep Mvar
 ORG0GUBUSOFF = F              /   RT->Plan: Disconnect gen bus with 0 unit ON
 ORGEQVRNWBRA = T              /   RT->Plan: Eqv. RNW connections into a single branch #ALTERADO
 ORGUDTCOLVAR = T              /   Show UDT variables in columns
!
!  Power flow options
!
 PFVOLTRST    = F              /   Reset controlled voltages to specified values                                                       
 PFFLTSTRT    = F              /   Use good start                                                                                      
 PFBLKSHT     = T              /   Block discrete shunt control                                                                        
 PFBLKTAP     = T              /   Block tap control                                                                                   
 PFDSCRTAP    = F              /   Enable discrete tap                                                                                 
 PFBLKSHFT    = T              /   Block phase shifter control                                                                         
 PFAREACNTRL  = F              /   Enable area interchange control                                                                     
 PFCHSSWING   = T              /   Enable auto-selection of swing Bus due to islanding                                                 
 PFDSTSLACK   = F              /   Enable distributed slack                                                                            
 PFCURRATING  = T              /   Current thermal limit instead of MVA                                                                
 PFMIDRANGE   = F              /   Discrete shunts and LTCs voltage control at middle of range                                         
 PFSTBDIAG    = T              /   Stabilizes Jacobian diagonal                                                                        
 PFIMPCORR    = F              /   Transformer impedance correction #ALTERADO                                                                    
 PFCHKCTRVLT  = F              /   Enforce local voltage limits if necessary (Remote V control)                                        
 PFEMRVLTLVL  = F              /   Use emergency voltage limits for enforcing local control                                            
 PFBLOCKQG    = F              /   Block Qg for selected buses (convert PV into PQ)
 PFDIAGPVT    = T              /   Use only diagonal pivoting in Newton Solution                                                       
 PFLOGMSG     = F              /   Display control limit messages                                                                      
 PFREDSWNG    = F              /   Swing generator minimum inertia #ALTERADO                                                                     
 PFPRLTRFTAP  = F              /   Equalize parallel OLTC transformers' Tap                                                            
 PFEQVCNTRL   = F              /   Equalize voltage settings of all devices controlling the same bus
 PFUSEFIXSHT  = F              /   Use fixed shunts as discrete shunts in the voltage control
