! Optimal power flow options
!
 OPFCENTER    = F              /   Center Initial Variable values                                                                      
 OPFBLKTAP    = T              /   Block Tap controls                                                                                  
 OPFDSCTAP    = F              /   Discrete Taps                                                                                       
 OPFBLKSHIFT  = T              /   Block Phase-Shift controls                                                                          
 OPFBLKDSHT   = T              /   Block Discrete Shunt controls                                                                       
 OPFLODSHD    = F              /   Allow load shedding                                                                                 
 OPFFIXDC     = T              /   Let DC Link power injections fixed in the loop optimization                                         
 OPFRLXSWNG   = F              /   Relax MW limits of swing buses                                                                      
 OPFRELAX     = F              /   Allow constraint relaxation                                                                         
 OPFCOMMIT    = F              /   Commit generation units if necessary                                                                
 OPFPFRUN     = F              /   Run a conventional power flow after OPF                                                             
 OPFNCPF      = F              /   Run a conventional power flow if OPF does not converge                                              
 OPFZRPMIN    = T              /   Allow zero generation? #ALTERADO                                                                              
 OPFFLWCNSTR  = F              /   Enforce branch flow constraint considering the capacity specified by OPFFLMTLVL                     
 OPFFLWEXPPNT = F              /   Exponential flow constraint penalty model (or Quadratic)                                            
 OPFDSHTDEV   = F              /   Minimizes discrete shunt deviations from the initial value, instead of zero                         
 OPFCSHTDEV   = F              /   Minimizes continuous shunt deviations from the initial value, instead of zero                       
 OPFITAPDEV   = T              /   Minimizes tap deviations from the initial value, instead of one                                     
 OPFGVARDEV   = F              /   Minimizes generator Mvar deviations from the initial value, instead of zero                         
 OPFVARBLNC   = F              /   True to balance Var and Volt penalties using OPFVARFCTR parameter                                   
 OPFSHTALOC   = F              /   True to allocate shunt compensation for voltage control                                             
 OPFTOPOCHG   = F              /   Switch off lines to improve voltage control or increase Mvar control margin                         
 OPFFXSHTCTR  = F              /   Use fixed shunts to control voltage
 OPFTLSHTCTR  = F              /   Use transmission line shunts to control voltage
 OPFMINGENU   = F              /   Minimum number of generating units 
 OPFVLENF     = F              /   Enforce voltage limits for base case setup object function                                          
 OPFBLKRNEW   = F              /   Block renewable generation
 OPFINTRCHGEN = F              /   True to use only selected generators for interchange control
!
! Time domain simulation options
!
 TDSAUTTERM   = F              /   Termination of simulation if instability detected #ALTERADO                                                   
 TDSFREQDEV   = F              /   Termination of simulation if frequency deviation is large #ALTERADO                                           
