!
! OPTIONS (LOGICAL PARAMETERS)
!
! Miscelanea
!
 ORGRMVISL    = T              /   Remove small islands after bus translation      !#!CONVERSÃO DE UGS                                                    
 ORGCHGNAMES  = F              /   Change bus names during bus number translation                                                      
 ORGADDUDT    = T              /   Add any results to UDT                                                                              
 ORGCAPBCURV  = F              /   Use Mvar capability curve instead of fixed limits                                                   
 ORGPWFMONIT  = F              /   Import monitoring parameters from PWF                                                               
 ORGDFAVRDYR  = F              /   Adds default AVR when reading DYR files                                                             
 ORGNOTRFPHS  = F              /   Ignores transformer phase shift when reading RAW files                                              
 ORGANAZNSEQ  = F              /   Import zero/negative sequences from ANA                                                             
 ORGPWFVSPEC  = T              /   Writes controlled voltage instead of bus voltage on PWF files     !#PARÂMETRO PLC                                  
 ORGOPGENMRG  = F              /   Zero gen minimum MW if it is equal to maximum MW                                                    
 ORGADJGENMVA = F              /   Adjust Generator MVA to Pmax and Qmax when reading NTW                                              
 ORGSHTSTON   = F              /   Set shunt block status to true when reading format NTW                                              
 ORGDCINVGMIN = F              /   Use DC Inverter minimum gamma when reading format NTW                                               
 ORGSHTOVRBUS = F              /   Allocate initial shunt exceeding shunt limits at bus                                                
 ORGEQVNOPF   = F              /   Allows run equivalent network reduction without power flow convergency                              
 ORGNTWBNT1   = F              /   Processes Bnt1.dat for NTW files (PSR software import only)                                         
 ORGLMTVSPEC  = F              /   Specified controlled voltage bound by monitored limits                                              
ORGEQVRNWBRA  = Y            RT->Plan: equivalenta as conecções das usinas renováveis em um único circuito? !#PARÂMETRO PLC 
ORGCONVLOG    = F            Save RT->Plan conversion log reports                                                                
ORGCONVMINER  = F            RT->Plan: Aggregate units with min inertia                                                          
ORGCONVALLGU  = T            Aggregate off gen units for RT->Plan conversion                                                     
ORGCONVEQVST  = F            Equivalent step up trafo for RT->Plan conversion                                                    
ORGCONVEQSTX  = F            Adjust stepup trafo impedance to keep Mvar, RT=>Plan                                                
ORG0GUBUSOFF  = F            Disconnect gen bus with 0 unit ON, RT=>Plan 
