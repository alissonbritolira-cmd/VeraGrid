 PFBLKSHFT    = T              /   Block phase shifter control                                                                         
 PFAREACNTRL  = F              /   Enable area interchange control                                                                     
 PFCHSSWING   = T              /   Enable auto-selection of swing Bus due to islanding                                                 
 PFDSTSLACK   = F              /   Enable distributed slack                                                                            
 PFCURRATING  = T              /   Current thermal limit instead of MVA                                                                
 PFMIDRANGE   = F              /   Discrete shunts and LTCs voltage control at middle of range                                         
 PFSTBDIAG    = T              /   Stabilizes Jacobian diagonal                                                                        
 PFIMPCORR    = T              /   Transformer impedance correction                                                                    
 PFCHKCTRVLT  = F              /   Enforce local voltage limits if necessary (Remote V control)                                        
 PFEMRVLTLVL  = F              /   Use emergency voltage limits for enforcing local control                                            
 PFDIAGPVT    = T              /   Use only diagonal pivoting in Newton Solution                                                       
 PFLOGMSG     = F              /   Display control limit messages                                                                      
